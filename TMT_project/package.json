{
  "name": "tmt-tax-and-milestone-tracker",
  "version": "1.0.0",
  "description": "Client compliance and billing tracker for Philippine accounting firm",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "server": "node node_modules/nodemon/bin/nodemon.js server/index.js",
    "client": "node node_modules/vite/bin/vite.js",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"npm run server\" \"npm run client\"",
    "build": "node node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "21.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.3.0",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.1",
    "vite": "^7.3.6"
  }
}
