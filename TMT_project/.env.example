# PostgreSQL Connection URL (Local or Cloud e.g. Neon/Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tmt_db

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_change_in_production
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production

